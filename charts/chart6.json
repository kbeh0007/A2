{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 500,
  "data": {
    "url": "https://kbeh0007.github.io/A2/data/qualifying.csv"
  },
  "transform": [
    {
      "filter": "datum.q1 !== '\\N' && datum.q1 !== ''"
    },
    {
      "lookup": "raceId",
      "from": {
        "data": {
          "url": "https://kbeh0007.github.io/A2/data/races.csv"
        },
        "key": "raceId",
        "fields": [
          "year",
          "circuitId"
        ]
      }
    },
    {
      "filter": "datum.circuitId == 9"
    },
    {
      "calculate": "toNumber(split(datum.q1, ':')[0]) * 60 + toNumber(split(datum.q1, ':')[1])",
      "as": "q1_seconds"
    },
    {
      "filter": "datum.q1_seconds > 60 && datum.q1_seconds < 200"
    },
    {
      "aggregate": [
        {
          "op": "min",
          "field": "q1_seconds",
          "as": "best_q1"
        }
      ],
      "groupby": [
        "year"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "opacity": 0.06,
        "color": "#4488ff"
      },
      "data": {
        "values": [
          {
            "x1": 1995.5,
            "x2": 2002.5
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "x1",
          "type": "quantitative",
          "scale": {
            "domain": [
              1995,
              2025
            ]
          }
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 500
        }
      }
    },
    {
      "mark": {
        "type": "rect",
        "opacity": 0.06,
        "color": "#ff4444"
      },
      "data": {
        "values": [
          {
            "x1": 2002.5,
            "x2": 2005.5
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "x1",
          "type": "quantitative",
          "scale": {
            "domain": [
              1995,
              2025
            ]
          }
