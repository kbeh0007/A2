{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 391,
  "height": 460,
  "data": {
    "url": "https://kbeh0007.github.io/A2/data/races.csv"
  },
  "transform": [
    {
      "lookup": "circuitId",
      "from": {
        "data": {
          "url": "https://kbeh0007.github.io/A2/data/circuits.csv"
        },
        "key": "circuitId",
        "fields": [
          "country"
        ]
      }
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "num_races"
        }
      ],
      "groupby": [
        "country"
      ]
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "num_races",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 15"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {
            "labelColor": "#cccccc",
            "labelFontSize": 11
          }
        },
        "x": {
          "field": "num_races",
          "type": "quantitative",
          "title": "Grands Prix hosted",
          "axis": {
            "title": "Grands Prix hosted",
            "titleColor": "#aaaaaa",
            "labelColor": "#aaaaaa",
            "gridColor": "#1a1a3a",
            "titleFontSize": 11
          }
        },
        "x2": {
          "value": 0
        },
        "color": {
          "condition": [
            {
              "test": "datum.rank == 1",
              "value": "#FFD700"
            },
            {
              "test": "datum.rank == 2",
              "value": "#C0C0C0"
            },
            {
              "test": "datum.rank == 4",
              "value": "#CD7F32"
            }
          ],
          "value": "#444466"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 90
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "num_races",
          "type": "quantitative",
          "title": "Grands Prix hosted",
          "axis": {
            "titleColor": "#888888",
            "labelColor": "#aaaaaa",
            "gridColor": "#1a1a3a",
            "titleFontSize": 11
          }
        },
        "color": {
          "condition": [
            {
              "test": "datum.rank == 1",
              "value": "#FFD700"
            },
            {
              "test": "datum.rank == 2",
              "value": "#C0C0C0"
            },
            {
              "test": "datum.rank == 4",
              "value": "#CD7F32"
            }
          ],
          "value": "#cc0000"
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "num_races",
            "title": "Races hosted"
          },
          {
            "field": "rank",
            "title": "Rank"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 10,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "num_races",
          "type": "quantitative",
          "axis": {
            "title": "Grands Prix hosted",
            "titleColor": "#aaaaaa",
            "labelColor": "#aaaaaa",
            "gridColor": "#1a1a3a",
            "titleFontSize": 11
          },
          "title": "Grands Prix hosted"
        },
        "text": {
          "field": "num_races"
        },
        "color": {
          "condition": [
            {
              "test": "datum.rank == 1",
              "value": "#FFD700"
            },
            {
              "test": "datum.rank == 2",
              "value": "#C0C0C0"
            },
            {
              "test": "datum.rank == 4",
              "value": "#CD7F32"
            }
          ],
          "value": "#aaaaaa"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -10,
        "fontSize": 9,
        "fontStyle": "italic",
        "color": "#ffd700"
      },
      "transform": [
        {
          "filter": "datum.country == 'Malaysia'"
        }
      ],
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "num_races",
          "type": "quantitative",
          "axis": {
            "title": "Grands Prix hosted",
            "titleColor": "#aaaaaa",
            "labelColor": "#aaaaaa",
            "gridColor": "#1a1a3a",
            "titleFontSize": 11
          },
          "title": "Grands Prix hosted"
        },
        "text": {
          "value": "\u2605 Malaysia"
        }
      }
    }
  ],
  "config": {
    "background": "#0d0d1a",
    "view": {
      "stroke": null
    }
  }
}