{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 620,
  "height": 300,
  "title": {
    "text": "Malaysia's Tourism Recovery \u2014 The Case to Return",
    "color": "#e0e0e0",
    "fontSize": 13,
    "fontWeight": 600,
    "anchor": "start"
  },
  "data": {
    "url": "https://kbeh0007.github.io/A2/data/malaysia_tourism.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.year)",
      "as": "yr"
    },
    {
      "calculate": "toNumber(datum.receipts_usd_b)",
      "as": "receipts"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#00d2be",
        "fillOpacity": 0.15,
        "line": {
          "color": "#00d2be",
          "strokeWidth": 2.2
        }
      },
      "encoding": {
        "x": {
          "field": "yr",
          "type": "quantitative",
          "title": "Year",
          "scale": {
            "domain": [
              1995,
              2024
            ]
          },
          "axis": {
            "format": "d",
            "labelColor": "#aaaaaa",
            "titleColor": "#aaaaaa",
            "gridColor": "#1a1a3a",
            "tickCount": 10
          }
        },
        "y": {
          "field": "receipts",
          "type": "quantitative",
          "title": "Tourism receipts (USD billion)",
          "axis": {
            "labelColor": "#aaaaaa",
            "titleColor": "#aaaaaa",
            "gridColor": "#1a1a3a"
          }
        },
        "tooltip": [
          {
            "field": "yr",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "receipts",
            "title": "Receipts (USD B)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#ffd700",
        "strokeWidth": 1.5,
        "strokeDash": [
          5,
          3
        ]
      },
      "data": {
        "values": [
          {
            "y": 0.07
          }
        ]
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              26
            ]
          }
        },
