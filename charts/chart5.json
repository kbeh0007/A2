{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 560,
  "height": 380,
  "data": {
    "url": "https://kbeh0007.github.io/A2/data/results.csv"
  },
  "transform": [
    {
      "filter": "datum.position == '1'"
    },
    {
      "lookup": "raceId",
      "from": {
        "data": {
          "url": "https://kbeh0007.github.io/A2/data/races.csv"
        },
        "key": "raceId",
        "fields": [
          "year"
        ]
      }
    },
    {
      "lookup": "constructorId",
      "from": {
        "data": {
          "url": "https://kbeh0007.github.io/A2/data/constructors.csv"
        },
        "key": "constructorId",
        "fields": [
          "name"
        ]
      }
    },
    {
      "calculate": "floor(datum.year / 10) * 10",
      "as": "decade"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "wins"
        }
      ],
      "groupby": [
        "name",
        "decade"
      ]
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "wins",
          "as": "total_wins"
        }
      ],
      "groupby": [
        "name"
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "filter": "datum.total_wins >= 10"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "dy": 4,
        "fontSize": 9,
        "color": "#ff9999",
        "fontStyle": "italic"
      },
      "data": {
        "values": [
          {
            "decade": 1990
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "ordinal"
        },
        "y": {
          "value": 0
        },
        "text": {
          "value": "Schumacher era"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "dy": 4,
        "fontSize": 9,
        "color": "#1a6644",
        "fontStyle": "italic"
      },
      "data": {
        "values": [
          {
            "decade": 2010
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "ordinal"
        },
        "y": {
          "value": 0
        },
        "text": {
          "value": "Hybrid era"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -12,
        "fontSize": 9,
        "color": "#1a6644",
        "fontStyle": "italic"
      },
      "data": {
        "values": [
          {
            "decade": 2010
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "ordinal"
        },
        "y": {
          "value": 0
        },
        "text": {
          "value": "Hybrid era"
        }
      }
    },
    {
      "mark": {
        "type": "rect"
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "ordinal",
          "title": "Decade",
          "axis": {
            "labelColor": "#333333",
            "titleColor": "#555555",
            "labelFontSize": 11,
            "labelExpr": "datum.value + 's'"
          }
        },
        "y": {
          "field": "name",
          "type": "nominal",
          "title": null,
          "sort": {
            "op": "sum",
            "field": "wins",
            "order": "descending"
          },
          "axis": {
            "labelColor": "#222222",
            "labelFontSize": 11,
            "labels": true,
            "title": null
          }
        },
        "color": {
          "field": "wins",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              "#fff0f0",
              "#ffaaaa",
              "#ff4444",
              "#cc0000",
              "#7a0000"
            ]
          },
          "legend": {
            "title": "Race wins",
            "titleColor": "#333333",
            "labelColor": "#333333",
            "orient": "right",
            "gradientLength": 150,
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "direction": "vertical"
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Constructor"
          },
          {
            "field": "decade",
            "title": "Decade"
          },
          {
            "field": "wins",
            "title": "Wins"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "ordinal"
        },
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "op": "sum",
            "field": "wins",
            "order": "descending"
          }
        },
        "text": {
          "condition": {
            "test": "datum.wins >= 50",
            "field": "wins"
          },
          "value": ""
        },
        "color": {
          "value": "#ffffff"
        }
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": "#dddddd"
    }
  }
}