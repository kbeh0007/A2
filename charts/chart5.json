{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 480,
  "height": 340,
  "data": {
    "url": "https://kbeh0007.github.io/A2/data/results.csv"
  },
  "transform": [
    {
      "filter": "datum.position == '1'"
    },
    {
      "lookup": "raceId",
      "from": {
        "data": {
          "url": "https://kbeh0007.github.io/A2/data/races.csv"
        },
        "key": "raceId",
        "fields": [
          "year"
        ]
      }
    },
    {
      "lookup": "constructorId",
      "from": {
        "data": {
          "url": "https://kbeh0007.github.io/A2/data/constructors.csv"
        },
        "key": "constructorId",
        "fields": [
          "name"
        ]
      }
    },
    {
      "calculate": "floor(datum.year / 10) * 10",
      "as": "decade"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "wins"
        }
      ],
      "groupby": [
        "name",
        "decade"
      ]
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "wins",
          "as": "total_wins"
        }
      ],
      "groupby": [
        "name"
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "filter": "datum.total_wins >= 50"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect"
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "ordinal",
          "title": "Decade",
          "axis": {
            "labelColor": "#cccccc",
            "titleColor": "#888888",
            "labelFontSize": 11,
            "labelExpr": "datum.value + 's'"
          }
        },
        "y": {
          "field": "name",
          "type": "nominal",
          "title": null,
          "sort": {
            "op": "sum",
            "field": "wins",
            "order": "descending"
          },
          "axis": {
            "labelColor": "#cccccc",
            "labelFontSize": 11
          }
        },
        "color": {
          "field": "wins",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              "#0d0d1a",
              "#3a0a0a",
              "#7a0000",
              "#cc0000",
              "#ff6644"
            ]
          },
          "legend": {
            "title": "Race wins",
            "titleColor": "#aaaaaa",
            "labelColor": "#aaaaaa",
            "orient": "right",
            "gradientLength": 150,
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "direction": "vertical"
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Constructor"
          },
          {
            "field": "decade",
            "title": "Decade"
          },
          {
            "field": "wins",
            "title": "Wins"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "ordinal"
        },
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "op": "sum",
            "field": "wins",
            "order": "descending"
          }
        },
        "text": {
          "condition": {
            "test": "datum.wins >= 50",
            "field": "wins"
          },
          "value": ""
        },
        "color": {
          "condition": {
            "test": "datum.wins >= 50",
            "value": "#ffffff"
          },
          "value": "#ffaaaa"
        }
      }
    },
    {
      "mark": {
        "type": "rect",
        "opacity": 0.1,
        "color": "#cc0000"
      },
      "data": {
        "values": [
          {
            "decade": 1990
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "ordinal"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 340
        }
      }
    },
    {
      "mark": {
        "type": "rect",
        "opacity": 0.08,
        "color": "#00d2be"
      },
      "data": {
        "values": [
          {
            "decade": 2010
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "ordinal"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 340
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -12,
        "fontSize": 9,
        "color": "#66ddcc",
        "fontStyle": "italic"
      },
      "data": {
        "values": [
          {
            "decade": 2010
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "ordinal"
        },
        "y": {
          "value": 0
        },
        "text": {
          "value": "Hybrid era"
        }
      }
    }
  ],
  "config": {
    "background": "#0d0d1a",
    "view": {
      "stroke": "#333355"
    }
  }
}