{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 460,
  "projection": {
    "type": "conicConformal",
    "center": [
      10,
      47
    ],
    "parallels": [
      44,
      58
    ],
    "scale": 779
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#6b9e6b",
        "stroke": "#4a7a4a",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://kbeh0007.github.io/A2/data/races.csv"
      },
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "num_races"
            }
          ],
          "groupby": [
            "circuitId"
          ]
        },
        {
          "lookup": "circuitId",
          "from": {
            "data": {
              "url": "https://kbeh0007.github.io/A2/data/circuits.csv"
            },
            "key": "circuitId",
            "fields": [
              "name",
              "location",
              "country",
              "lat",
              "lng",
              "circuitId"
            ]
          }
        },
        {
          "filter": "datum.lng > -15 && datum.lng < 35 && datum.lat > 35 && datum.lat < 62"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "triangle-down",
        "opacity": 0.85,
        "strokeWidth": 0,
        "filled": true
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "num_races",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [
              4,
              220
            ]
          },
          "legend": null
        },
        "color": {
          "field": "num_races",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              70
            ],
            "range": [
              "#fff0f0",
              "#ffaaaa",
              "#ff4444",
              "#cc0000",
              "#7a0000"
            ]
          },
          "legend": {
            "title": "Races hosted",
            "titleColor": "#ffffff",
            "labelColor": "#ffffff",
            "orient": "bottom-right",
            "direction": "horizontal",
            "gradientLength": 120,
            "values": [
              1,
              20,
              40,
              60,
              80
            ]
          }
        },
        "stroke": {
          "field": "num_races",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              70
            ],
            "range": [
              "#ffaaaa",
              "#ff4444",
              "#cc0000",
              "#880000",
              "#440000"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Circuit"
          },
          {
            "field": "location",
            "title": "City"
          },
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "num_races",
            "title": "Races hosted"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://kbeh0007.github.io/A2/data/races.csv"
      },
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "num_races"
            }
          ],
          "groupby": [
            "circuitId"
          ]
        },
        {
          "lookup": "circuitId",
          "from": {
            "data": {
              "url": "https://kbeh0007.github.io/A2/data/circuits.csv"
            },
            "key": "circuitId",
            "fields": [
              "name",
              "location",
              "country",
              "lat",
              "lng"
            ]
          }
        },
        {
          "filter": "datum.lng > -15 && datum.lng < 35 && datum.lat > 35 && datum.lat < 62"
        },
        {
          "filter": "datum.num_races >= 50"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 10,
        "fontSize": 9,
        "fontWeight": "bold",
        "color": "#ffffff",
        "baseline": "top",
        "align": "center"
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "location",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#4a90c4",
    "view": {
      "stroke": null
    }
  }
}