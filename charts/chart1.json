{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 900,
  "height": 450,
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#1a1a2e",
        "stroke": "#333355",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {"url": "data/races.csv"},
      "transform": [
        {
          "aggregate": [{"op": "count", "as": "num_races"}],
          "groupby": ["circuitId"]
        },
        {
          "lookup": "circuitId",
          "from": {
            "data": {"url": "data/circuits.csv"},
            "key": "circuitId",
            "fields": ["name", "location", "country", "lat", "lng", "circuitId"]
          }
        },
        {"filter": "datum.circuitId != 2"}
      ],
      "mark": {
        "type": "point",
        "shape": "triangle-down",
        "opacity": 0.9,
        "strokeWidth": 0,
        "filled": true
      },
      "encoding": {
        "longitude": {"field": "lng", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "num_races",
          "type": "quantitative",
          "scale": {"range": [30, 200]},
          "legend": null
        },
        "color": {
          "field": "num_races",
          "type": "quantitative",
          "scale": {
            "domain": [1, 70],
            "range": ["#ff9999", "#cc0000"]
          },
          "legend": {
            "title": "Races hosted",
            "titleColor": "#aaaaaa",
            "labelColor": "#aaaaaa",
            "orient": "bottom-left",
            "gradientLength": 120
          }
        },
        "tooltip": [
          {"field": "name", "title": "Circuit"},
          {"field": "location", "title": "Location"},
          {"field": "country", "title": "Country"},
          {"field": "num_races", "title": "Races hosted"}
        ]
      }
    },
    {
      "data": {"url": "data/races.csv"},
      "transform": [
        {
          "aggregate": [{"op": "count", "as": "num_races"}],
          "groupby": ["circuitId"]
        },
        {
          "lookup": "circuitId",
          "from": {
            "data": {"url": "data/circuits.csv"},
            "key": "circuitId",
            "fields": ["name", "location", "country", "lat", "lng", "circuitId"]
          }
        },
        {"filter": "datum.circuitId == 2"}
      ],
      "mark": {
        "type": "point",
        "shape": "triangle-down",
        "opacity": 1,
        "strokeWidth": 1,
        "stroke": "#ffffff",
        "filled": true
      },
      "encoding": {
        "longitude": {"field": "lng", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {"value": 300},
        "color": {"value": "#ffd700"},
        "tooltip": [
          {"field": "name", "title": "Circuit"},
          {"field": "location", "title": "Location"},
          {"field": "country", "title": "Country"},
          {"field": "num_races", "title": "Races hosted"}
        ]
      }
    },
    {
      "data": {"url": "data/circuits.csv"},
      "transform": [
        {"filter": "datum.circuitId == 2"}
      ],
      "mark": {
        "type": "text",
        "dy": -16,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#ffd700"
      },
      "encoding": {
        "longitude": {"field": "lng", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"value": "Sepang ★"}
      }
    }
  ],
  "config": {
    "background": "#0d0d1a",
    "view": {"stroke": null}
  }
}