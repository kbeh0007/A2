{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 760,
  "height": 340,
  "data": {
    "url": "https://kbeh0007.github.io/A2/data/results.csv"
  },
  "transform": [
    {
      "filter": "datum.position == '1'"
    },
    {
      "lookup": "raceId",
      "from": {
        "data": {
          "url": "https://kbeh0007.github.io/A2/data/races.csv"
        },
        "key": "raceId",
        "fields": [
          "year"
        ]
      }
    },
    {
      "lookup": "constructorId",
      "from": {
        "data": {
          "url": "https://kbeh0007.github.io/A2/data/constructors.csv"
        },
        "key": "constructorId",
        "fields": [
          "name"
        ]
      }
    },
    {
      "calculate": "datum.name == 'Ferrari' || datum.name == 'McLaren' || datum.name == 'Mercedes' || datum.name == 'Red Bull' || datum.name == 'Williams' ? datum.name : 'Others'",
      "as": "team_group"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "wins"
        }
      ],
      "groupby": [
        "team_group",
        "year"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "wins",
          "as": "total_races_year"
        }
      ],
      "groupby": [
        "year"
      ]
    },
    {
      "calculate": "datum.wins / datum.total_races_year * 100",
      "as": "win_share"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "highlight",
          "select": {
            "type": "point",
            "on": "mouseover",
            "fields": [
              "team_group"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 2,
        "cornerRadiusTopRight": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Year",
          "axis": {
            "format": "d",
            "labelColor": "#aaaaaa",
            "titleColor": "#aaaaaa",
            "gridColor": "#1a1a3a"
          }
        },
        "y": {
          "field": "win_share",
          "type": "quantitative",
          "title": "Share of race wins (%)",
          "stack": "zero",
          "axis": {
            "labelColor": "#aaaaaa",
            "titleColor": "#aaaaaa",
            "gridColor": "#1a1a3a"
          }
        },
        "color": {
          "field": "team_group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Ferrari",
              "McLaren",
              "Mercedes",
              "Red Bull",
              "Williams",
              "Others"
            ],
            "range": [
              "#dc0000",
              "#ff8000",
              "#00d2be",
              "#ffd700",
              "#87CEEB",
              "#555566"
            ]
          },
          "legend": {
            "title": "Hover to highlight",
            "titleColor": "#aaaaaa",
            "labelColor": "#cccccc",
            "orient": "right"
          }
        },
        "opacity": {
          "condition": {
            "param": "highlight",
            "value": 1
          },
          "value": 0.1
        },
        "tooltip": [
          {
            "field": "team_group",
            "title": "Constructor"
          },
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "wins",
            "title": "Wins"
          },
          {
            "field": "win_share",
            "title": "Win share (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#dc0000",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ]
      },
      "data": {
        "values": [
          {
            "x": 2002,
            "y1": 0,
            "y2": 100
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y1",
          "type": "quantitative"
        },
        "y2": {
          "field": "y2"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -4,
        "dy": -6,
        "fontSize": 9,
        "color": "#dc0000",
        "fontWeight": "bold",
        "fontStyle": "italic"
      },
      "data": {
        "values": [
          {
            "x": 2002,
            "y": 100
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "value": "Ferrari peak"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#00d2be",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ]
      },
      "data": {
        "values": [
          {
            "x": 2016,
            "y1": 0,
            "y2": 100
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y1",
          "type": "quantitative"
        },
        "y2": {
          "field": "y2"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": -6,
        "fontSize": 9,
        "color": "#00d2be",
        "fontWeight": "bold",
        "fontStyle": "italic"
      },
      "data": {
        "values": [
          {
            "x": 2016,
            "y": 100
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "value": "Mercedes 19/21 wins"
        }
      }
    }
  ],
  "config": {
    "background": "#0d0d1a",
    "view": {
      "stroke": null
    }
  }
}