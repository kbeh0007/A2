            "y": {
              "value": 0
            },
            "y2": {
              "value": 150
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 4,
            "dy": 12,
            "fontSize": 9,
            "color": "#ffd700",
