{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://kbeh0007.github.io/A2/data/f1_growth.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.year)",
      "as": "yr"
    },
    {
      "calculate": "toNumber(datum.tv_viewers_millions)",
      "as": "viewers"
    },
    {
      "calculate": "toNumber(datum.total_attendance_millions)",
      "as": "attendance"
    }
  ],
  "vconcat": [
    {
      "title": {
        "text": [
          "TV Viewers (millions)",
          "\u2590  Malaysia on calendar  \u258c"
        ],
        "color": [
          "#e0e0e0",
          "#ffd700"
        ],
        "fontSize": [
          13,
          10
        ],
        "anchor": "start"
      },
      "width": 430,
      "height": 150,
      "layer": [
        {
          "mark": {
            "type": "rect",
            "opacity": 0.08,
            "color": "#ffd700"
          },
          "data": {
            "values": [
              {
                "x1": 2007.5,
                "x2": 2017.8
              }
            ]
          },
          "encoding": {
            "x": {
              "field": "x1",
              "type": "quantitative",
              "scale": {
                "domain": [
                  2007,
                  2026
                ]
              }
            },
            "x2": {
              "field": "x2"
            },
            "y": {
              "value": 0
            },
            "y2": {
              "value": 150
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.viewers > 0 && datum.yr >= 2008"
            }
          ],
          "mark": {
            "type": "area",
            "color": "#cc0000",
            "fillOpacity": 0.15,
            "line": {
              "color": "#cc0000",
              "strokeWidth": 2.2
            }
          },
          "encoding": {
            "x": {
              "field": "yr",
              "type": "quantitative",
              "title": null,
              "scale": {
                "domain": [
                  2007,
                  2026
                ]
              },
              "axis": {
                "format": "d",
                "labelColor": "#aaaaaa",
                "gridColor": "#1a1a3a",
                "tickCount": 10
              }
            },
            "y": {
              "field": "viewers",
              "type": "quantitative",
              "title": "Viewers (M)",
              "scale": {
                "domain": [
                  0,
                  700
                ]
              },
              "axis": {
                "labelColor": "#aaaaaa",
                "titleColor": "#cc0000",
                "gridColor": "#1a1a3a",
                "titleFontSize": 10
              }
            },
            "tooltip": [
              {
                "field": "yr",
                "title": "Year",
                "format": "d"
              },
              {
                "field": "viewers",
                "title": "TV viewers (M)",
                "format": ".0f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "#ffd700",
            "strokeWidth": 1.5,
            "strokeDash": [
              4,
              3
            ]
          },
          "data": {
            "values": [
              {
                "x": 2017
              }
            ]
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative",
              "scale": {
                "domain": [
                  2007,
                  2026
