{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 430,
  "height": 280,
  "data": {"url": "data/f1_growth.csv"},
  "transform": [
    {"calculate": "toNumber(datum.year)", "as": "yr"},
    {"calculate": "toNumber(datum.revenue_billion_usd)", "as": "revenue"},
    {"calculate": "toNumber(datum.avg_ticket_usd)", "as": "ticket"}
  ],
  "layer": [
    {
      "mark": {"type": "rect", "opacity": 0.1, "color": "#ffd700"},
      "data": {"values": [{"x1": 2007.5, "x2": 2017.8}]},
      "encoding": {
        "x": {
          "field": "x1",
          "type": "quantitative",
          "scale": {"domain": [2007, 2026]}
        },
        "x2": {"field": "x2"},
        "y": {"value": 0},
        "y2": {"value": 280}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "dy": 8,
        "fontSize": 9,
        "color": "#ffd700"
      },
      "data": {"values": [{"x": 2012.5, "y": 0}]},
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {"domain": [2007, 2026]}
        },
        "y": {"field": "y", "type": "quantitative"},
        "text": {"value": "Malaysia on calendar"}
      }
    },
    {
      "transform": [
        {"filter": "datum.revenue > 0 && datum.yr >= 2008"}
      ],
      "mark": {
        "type": "line",
        "color": "#cc0000",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "yr",
          "type": "quantitative",
          "title": "Year",
          "scale": {"domain": [2007, 2026]},
          "axis": {
            "format": "d",
            "labelColor": "#aaaaaa",
            "titleColor": "#aaaaaa",
            "gridColor": "#1a1a3a",
            "tickCount": 10
          }
        },
        "y": {
          "field": "revenue",
          "type": "quantitative",
          "title": "Revenue (billion USD)",
          "scale": {"domain": [0, 5]},
          "axis": {
            "orient": "left",
            "labelColor": "#cc0000",
            "titleColor": "#cc0000",
            "gridColor": "#1a1a3a"
          }
        },
        "tooltip": [
          {"field": "yr", "title": "Year", "format": "d"},
          {"field": "revenue", "title": "Revenue (B USD)", "format": ".2f"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.ticket > 0 && datum.yr >= 2008"}
      ],
      "mark": {
        "type": "line",
        "color": "#ffd700",
        "strokeWidth": 2,
        "strokeDash": [5, 3],
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "yr",
          "type": "quantitative",
          "scale": {"domain": [2007, 2026]}
        },
        "y": {
          "field": "ticket",
          "type": "quantitative",
          "scale": {"domain": [0, 600]},
          "axis": {
            "orient": "right",
            "labelColor": "#ffd700",
            "titleColor": "#ffd700",
            "title": "Avg ticket price (USD)",
            "gridColor": "#1a1a3a"
          }
        },
        "tooltip": [
          {"field": "yr", "title": "Year", "format": "d"},
          {"field": "ticket", "title": "Avg ticket (USD)", "format": ".0f"}
        ]
      }
    }
  ],
  "resolve": {"scale": {"y": "independent"}},
  "config": {"background": "#0d0d1a", "view": {"stroke": null}}
}